{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataproxy.local/contracts/data_asset_pack/section_units.schema.json",
  "title": "DataProxy Section Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "section_id",
    "document_id",
    "source_path",
    "title",
    "title_path",
    "logical_section_id",
    "parent_logical_section_id",
    "chunk_index",
    "chunk_count",
    "chunk_overlap_chars",
    "is_chunk",
    "source_order",
    "heading_level",
    "page_role",
    "page_roles",
    "locator",
    "source_block_refs",
    "source_layout_refs",
    "quality"
  ],
  "properties": {
    "contract_version": {"const": "data_asset_pack"},
    "section_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "title_path": {"type": "array", "items": {"type": "string"}},
    "logical_section_id": {"type": "string", "minLength": 1},
    "parent_logical_section_id": {"type": ["string", "null"]},
    "chunk_index": {"type": "integer", "minimum": 0},
    "chunk_count": {"type": "integer", "minimum": 1},
    "chunk_overlap_chars": {"type": "integer", "minimum": 0},
    "is_chunk": {"type": "boolean"},
    "source_order": {"type": "integer", "minimum": 0},
    "heading_level": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "page_role": {"type": ["string", "null"]},
    "page_roles": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "locator": {"type": "object", "additionalProperties": true},
    "source_block_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_layout_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "text_view": {"type": ["string", "null"]},
    "quality": {"$ref": "#/$defs/quality"}
  },
  "$defs": {
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["issues"],
      "properties": {
        "issues": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }
    }
  }
}
