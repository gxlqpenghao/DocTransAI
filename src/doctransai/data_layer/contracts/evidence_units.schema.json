{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataproxy.local/contracts/data_asset_pack/evidence_units.schema.json",
  "title": "DataProxy Evidence Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evidence_id",
    "document_id",
    "source_path",
    "object_type",
    "object_id",
    "evidence_kind",
    "text",
    "locator",
    "source_block_refs",
    "source_layout_refs",
    "quality"
  ],
  "properties": {
    "contract_version": {"const": "data_asset_pack"},
    "evidence_id": {"$ref": "#/$defs/non_empty_string"},
    "document_id": {"$ref": "#/$defs/non_empty_string"},
    "source_path": {"$ref": "#/$defs/non_empty_string"},
    "source_checksum": {"type": ["string", "null"]},
    "document_title": {"type": ["string", "null"]},
    "object_type": {
      "enum": ["section", "table", "sheet", "cell_range", "visual_projection"]
    },
    "object_id": {"$ref": "#/$defs/non_empty_string"},
    "evidence_kind": {
      "enum": ["text_chunk", "toc", "cover", "table", "sheet_range", "other_page"]
    },
    "text": {"type": "string"},
    "page_role": {"type": ["string", "null"]},
    "page_roles": {
      "type": "array",
      "items": {"$ref": "#/$defs/page_role"}
    },
    "title": {"type": ["string", "null"]},
    "title_path": {
      "type": "array",
      "items": {"type": "string"}
    },
    "locator": {"$ref": "#/$defs/locator"},
    "logical_section_id": {"type": ["string", "null"]},
    "parent_logical_section_id": {"type": ["string", "null"]},
    "chunk_index": {"type": ["integer", "null"], "minimum": 0},
    "chunk_count": {"type": ["integer", "null"], "minimum": 1},
    "is_chunk": {"type": ["boolean", "null"]},
    "chunk_overlap_chars": {"type": ["integer", "null"], "minimum": 0},
    "table_id": {"type": ["string", "null"]},
    "table_json": {"type": ["object", "null"]},
    "full_table_text": {"type": ["string", "null"]},
    "table_ref": {"type": ["string", "null"]},
    "visual_asset_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "visual_asset_id": {"type": ["string", "null"]},
    "source_block_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_layout_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "lineage": {"type": "object", "additionalProperties": true},
    "quality": {"$ref": "#/$defs/quality"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"object_type": {"enum": ["section", "table", "visual_projection"]}},
        "required": ["object_type"]
      },
      "then": {
        "required": ["page_role", "page_roles", "title_path", "logical_section_id", "chunk_index"]
      }
    },
    {
      "if": {
        "properties": {"object_type": {"const": "sheet"}},
        "required": ["object_type"]
      },
      "then": {
        "properties": {
          "evidence_kind": {"const": "sheet_range"},
          "locator": {
            "allOf": [
              {"$ref": "#/$defs/locator"},
              {
                "required": ["sheet_name"],
                "properties": {
                  "sheet_name": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"object_type": {"const": "cell_range"}},
        "required": ["object_type"]
      },
      "then": {
        "properties": {
          "evidence_kind": {"const": "sheet_range"},
          "locator": {
            "allOf": [
              {"$ref": "#/$defs/locator"},
              {
                "required": ["sheet_name"],
                "properties": {
                  "sheet_name": {"type": "string", "minLength": 1}
                },
                "anyOf": [
                  {
                    "required": ["range_ref"],
                    "properties": {"range_ref": {"type": "string", "minLength": 1}}
                  },
                  {
                    "required": ["cell_range"],
                    "properties": {"cell_range": {"type": "string", "minLength": 1}}
                  },
                  {
                    "required": ["cell_range_id"],
                    "properties": {"cell_range_id": {"type": "string", "minLength": 1}}
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_kind": {"const": "table"}},
        "required": ["evidence_kind"]
      },
      "then": {
        "required": ["table_id"],
        "properties": {"table_id": {"type": "string", "minLength": 1}},
        "anyOf": [
          {
            "required": ["table_json"],
            "properties": {"table_json": {"type": "object", "minProperties": 1}}
          },
          {
            "required": ["full_table_text"],
            "properties": {"full_table_text": {"type": "string", "minLength": 1}}
          },
          {
            "required": ["table_ref"],
            "properties": {"table_ref": {"type": "string", "minLength": 1}}
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"object_type": {"const": "visual_projection"}},
        "required": ["object_type"]
      },
      "then": {
        "required": ["visual_asset_id"]
      }
    }
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "page_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "confidence"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locator_type": {"type": ["string", "null"]},
        "page_anchor": {"type": ["string", "null"]},
        "page_start": {"type": ["string", "null"]},
        "page_end": {"type": ["string", "null"]},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0},
        "bbox": {
          "anyOf": [
            {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
            {"type": "null"}
          ]
        },
        "sheet_id": {"type": ["string", "null"]},
        "sheet_name": {"type": ["string", "null"], "minLength": 1},
        "range_ref": {"type": ["string", "null"], "minLength": 1},
        "cell_range": {"type": ["string", "null"], "minLength": 1},
        "cell_range_id": {"type": ["string", "null"], "minLength": 1},
        "section_id": {"type": ["string", "null"]},
        "table_id": {"type": ["string", "null"]},
        "table_title": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "status": {"type": ["string", "null"]}
      }
    }
  }
}
