{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataproxy.local/contracts/parse_jobs/parse_artifact_manifest.schema.json",
  "title": "DataProxy Parse Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "contract_version", "job_id", "project_id", "created_at", "reference_base", "entrypoints", "task", "quality", "source", "components", "integrity", "capabilities"],
  "properties": {
    "artifact_type": {"const": "DataProxyParseArtifact"},
    "contract_version": {"const": "parse_artifact"},
    "job_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "reference_base": {"const": "package_root"},
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parsed_document_bundle"],
      "properties": {
        "parsed_document_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "contract_version", "schema_path", "reference_base"],
          "properties": {
            "path": {"const": "content/parsed_document_bundle.json"},
            "contract_version": {"const": "data_asset_pack"},
            "schema_path": {"const": "schema/parsed_document_bundle.schema.json"},
            "reference_base": {"const": "package_root"}
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "success", "failure"],
      "properties": {
        "status": {"const": "succeeded"},
        "success": {"const": true},
        "failure": {"type": ["string", "object", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "complete", "summary", "warnings", "missing_components", "parse_errors"],
      "properties": {
        "status": {"enum": ["complete", "degraded", "failed"]},
        "complete": {"type": "boolean"},
        "summary": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "object"}},
        "missing_components": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "parse_errors": {"type": "array", "items": {"type": "object"}}
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "original_filename", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "original_filename": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "count", "delivered"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "count": {"type": "integer", "minimum": 0},
          "delivered": {"type": "boolean"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "capabilities": {"type": "object"}
  }
}
