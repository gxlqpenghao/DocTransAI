# Backend configuration only. Copy to .env; pass --env-file .env explicitly.
# Replace placeholders with your project's DataProxy authorization and LLM credentials.
DOCTRANSAI_DATAPROXY_BASE_URL=https://dataproxy.example.com
DOCTRANSAI_DATAPROXY_API_KEY=replace-with-project-authorization-key
DOCTRANSAI_LLM_BASE_URL=https://your-provider.example/v1
DOCTRANSAI_LLM_API_KEY=replace-with-llm-key
DOCTRANSAI_LLM_MODEL=kimi-k3
DOCTRANSAI_LLM_MAX_TOKENS=16000
# auto: high for kimi-k3, omitted for other models. omit means do not send the field.
DOCTRANSAI_LLM_REASONING_EFFORT=auto
DOCTRANSAI_LLM_TIMEOUT_SECONDS=180
DOCTRANSAI_LLM_TOKEN_PARAMETER=max_tokens
DOCTRANSAI_LLM_STREAM_USAGE=true
# Set only when supported; omit excludes temperature from the request.
# DOCTRANSAI_LLM_TEMPERATURE=omit
# DOCTRANSAI_LLM_MAX_REQUEST_BYTES=6000000
# DOCTRANSAI_LLM_MAX_INPUT_CHARS=0

# For Docker use /renderer/render_docx.py and python, with renderer mounted read-only.
DOCTRANSAI_DOCX_RENDERER=/absolute/path/render_docx.py
DOCTRANSAI_RENDER_PYTHON=/absolute/path/python3
# DOCTRANSAI_PDFTOPPM=/absolute/path/pdftoppm

# Explicit opt-in for ONE approved HTTP origin; empty keeps HTTPS required.
# HTTP exposes project credentials/files in transit; configure only for an approved deployment.
DOCTRANSAI_DATAPROXY_ALLOWED_HTTP_ORIGIN=
