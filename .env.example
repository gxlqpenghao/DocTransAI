# Copy to a local .env and replace placeholders. Never commit real credentials.
DOCTRANSAI_LLM_API_KEY=replace-with-kimi-k3-key
DOCTRANSAI_LLM_BASE_URL=https://provider.example/v1
DOCTRANSAI_LLM_REASONING_EFFORT=max

# Required for DOC/DOCX/PDF visual preparation on the local machine.
DOCTRANSAI_DOCX_RENDERER=/path/to/render_docx.py
DOCTRANSAI_RENDER_PYTHON=/path/to/python3
