{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataproxy.local/contracts/data_asset_pack_v0/diagnostics.schema.json",
  "title": "DataProxy Diagnostics v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "diagnostic_id",
    "diagnostic_class",
    "code",
    "severity",
    "phase",
    "source_path",
    "document_id",
    "block_id",
    "evidence_id",
    "table_id",
    "asset_id",
    "sheet_id",
    "cell_range_id",
    "page_anchor",
    "bbox",
    "sheet_name",
    "range_ref",
    "remediation_eligible",
    "remediation_executed",
    "residual",
    "producer",
    "message",
    "field"
  ],
  "properties": {
    "contract_version": {"const": "data_asset_pack_v0"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "diagnostic_class": {"enum": ["quality_gate", "delivery_contract", "visual_asset"]},
    "code": {"type": ["string", "null"]},
    "severity": {"type": ["string", "null"]},
    "phase": {"type": "string", "minLength": 1},
    "source_path": {"type": ["string", "null"]},
    "document_id": {"type": ["string", "null"]},
    "block_id": {"type": ["string", "null"]},
    "evidence_id": {"type": ["string", "null"]},
    "table_id": {"type": ["string", "null"]},
    "asset_id": {"type": ["string", "null"]},
    "sheet_id": {"type": ["string", "null"]},
    "cell_range_id": {"type": ["string", "null"]},
    "page_anchor": {"type": ["string", "null"]},
    "bbox": {
      "anyOf": [
        {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        {"type": "null"}
      ]
    },
    "sheet_name": {"type": ["string", "null"]},
    "range_ref": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "cell_anchor": {"type": ["string", "null"]},
    "remediation_eligible": {"type": "boolean"},
    "remediation_executed": {"type": "boolean"},
    "residual": {"type": "boolean"},
    "producer": {"type": "string", "minLength": 1},
    "message": {"type": ["string", "null"]},
    "field": {"type": ["string", "null"]}
  }
}
