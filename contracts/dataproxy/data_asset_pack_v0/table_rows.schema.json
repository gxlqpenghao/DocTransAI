{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataproxy.local/contracts/data_asset_pack_v0/table_rows.schema.json",
  "title": "DataProxy Table Row v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "table_row_id",
    "document_id",
    "source_path",
    "table_id",
    "table_title",
    "page_anchor",
    "row_index",
    "is_header",
    "cells",
    "row_text",
    "quality"
  ],
  "properties": {
    "contract_version": {"const": "data_asset_pack_v0"},
    "table_row_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "table_id": {"type": "string", "minLength": 1},
    "table_title": {"type": ["string", "null"]},
    "page_anchor": {"type": ["string", "null"]},
    "row_index": {"type": "integer", "minimum": 1},
    "is_header": {"type": "boolean"},
    "cells": {
      "type": "array",
      "items": {"type": "string"}
    },
    "row_text": {"type": "string"},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    }
  }
}
